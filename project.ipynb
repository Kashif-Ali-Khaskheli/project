import cv2
import numpy as np
import imutils
from google.colab import files
from google.colab.patches import cv2_imshow

def order_points(pts):
    rect = np.zeros((4, 2), dtype="float32")

    s = pts.sum(axis=1)
    rect[0] = pts[np.argmin(s)]
    rect[2] = pts[np.argmax(s)]

    d = np.diff(pts, axis=1)
    rect[1] = pts[np.argmin(d)]
    rect[3] = pts[np.argmax(d)]

    return rect

def four_point_transform(image, pts):
    rect = order_points(pts)

    tl, tr, br, bl = rect

    widthA = np.linalg.norm(br - bl)
    widthB = np.linalg.norm(tr - tl)
    maxWidth = max(int(widthA), int(widthB))

    heightA = np.linalg.norm(tr - br)
    heightB = np.linalg.norm(tl - bl)
    maxHeight = max(int(heightA), int(heightB))

    dst = np.array([
        [0, 0],
        [maxWidth - 1, 0],
        [maxWidth - 1, maxHeight - 1],
        [0, maxHeight - 1]
    ], dtype="float32")

    M = cv2.getPerspectiveTransform(rect, dst)

    return cv2.warpPerspective(
        image,
        M,
        (maxWidth, maxHeight)
    )

uploaded = files.upload()

filename = list(uploaded.keys())[0]

image = cv2.imread(filename)

if image is None:
    print("Image load nahi hui.")
else:
    original = image.copy()

    resized = imutils.resize(image, height=500)

    ratio = original.shape[0] / resized.shape[0]

    gray = cv2.cvtColor(resized, cv2.COLOR_BGR2GRAY)

    gray = cv2.GaussianBlur(gray, (5, 5), 0)

    edges = cv2.Canny(gray, 75, 200)

    contours = cv2.findContours(
        edges.copy(),
        cv2.RETR_LIST,
        cv2.CHAIN_APPROX_SIMPLE
    )

    contours = imutils.grab_contours(contours)

    contours = sorted(
        contours,
        key=cv2.contourArea,
        reverse=True
    )[:5]

    document = None

    for contour in contours:
        perimeter = cv2.arcLength(contour, True)

        approx = cv2.approxPolyDP(
            contour,
            0.02 * perimeter,
            True
        )

        if len(approx) == 4:
            document = approx
            break

    if document is None:
        print("Document detect nahi hua.")
        print("Aisi image use karo jisme document ke edges clear hon.")
        cv2_imshow(original)
        cv2_imshow(edges)

    else:
        points = document.reshape(4, 2)

        points = points * ratio

        scanned = four_point_transform(
            original,
            points
        )

        scanned = cv2.resize(
            scanned,
            (557, 480)
        )

        detected = resized.copy()

        points_small = (points / ratio).astype("int32")

        cv2.drawContours(
            detected,
            [points_small],
            -1,
            (0, 255, 0),
            3
        )

        print("Original Image")
        cv2_imshow(original)

        print("Edge Detection")
        cv2_imshow(edges)

        print("Detected Document")
        cv2_imshow(detected)

        print("Scanned Document")
        cv2_imshow(scanned)

        cv2.imwrite(
            "scanned_document.jpg",
            scanned
        )

        print("Scanning complete!")

        files.download("scanned_document.jpg")